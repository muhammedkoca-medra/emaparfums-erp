# EMAPARFUMS ERP — üretim ortam değişkenleri ŞABLONU.
# Kopyala:  cp deploy/env.prod.example deploy/.env   ve değerleri doldur.
# deploy/.env ASLA git'e commit edilmez (.gitignore). Gizli anahtarları openssl ile üret (bkz. docs/08).

# Alt alan adın (DNS A kaydı bu sunucunun IP'sine bakmalı). HTTPS otomatik gelir.
DOMAIN=erp.alanadiniz.com

# PostgreSQL parolası (güçlü, rastgele).   openssl rand -base64 24
DB_PASSWORD=degistir-guclu-parola

# Oturum imzalama (>=32 karakter).   openssl rand -base64 32
AUTH_SECRET=

# KVKK PII şifreleme. Biçim: k1:<base64>  — "k1:" + (openssl rand -base64 32)
PII_ENC_KEYS=k1:
PII_ENC_ACTIVE_KEY=k1
# Arama için HMAC anahtarı.   openssl rand -base64 32
PII_HASH_KEY=

# Webhook imzaları (>=16).   openssl rand -base64 24
PAYMENT_WEBHOOK_SECRET=
EINVOICE_WEBHOOK_SECRET=

# Dış sistemler: başlangıçta mock. Gerçek anahtarlar girilince "auto" yapılır.
INTEGRATIONS_MODE=mock
LOG_LEVEL=info

# İlk yönetici hesabı (tohumlama için). Parolayı güçlü seç; ilk girişte değiştir.
SEED_ADMIN_EMAIL=admin@emaparfums.local
SEED_ADMIN_PASSWORD=degistir-ilk-giriste

# NOT: MFA_REQUIRED=true ve COOKIE_SECURE=true üretimde compose'ta sabittir (zorunlu güvenlik).
#      İlk admin girişinde iki adımlı doğrulama (TOTP) kurulur.
