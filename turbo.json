{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", "eslint.config.mjs", "tsconfig.base.json", ".prettierrc.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "src/generated/**"]
    },
    "dev": { "dependsOn": ["^build"], "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^build"] },
    "typecheck": { "dependsOn": ["^build"], "outputs": ["src/generated/**"] },
    "test": { "dependsOn": ["^build"], "cache": false }
  }
}
