# --- Veritabanı ve altyapı (docker compose ile uyumlu) ---
DATABASE_URL=postgresql://atelier:atelier@localhost:5432/atelier
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=atelier
S3_ACCESS_KEY=atelier
S3_SECRET_KEY=atelier-secret

# --- Uygulama ---
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
JWT_SECRET=degistir
FIELD_ENCRYPTION_KEY=   # 32 bayt, base64 — TCKN/VKN/telefon alan şifrelemesi

# --- Entegrasyonlar (docs/04-entegrasyonlar.md) — boş bırakılan adaptör MOCK modunda çalışır ---
EINVOICE_PROVIDER=mock        # özel entegratör kodu
EINVOICE_API_KEY=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
STRIPE_SECRET_KEY=
TRENDYOL_SUPPLIER_ID=
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=
HEPSIBURADA_MERCHANT_ID=
HEPSIBURADA_API_KEY=
AMAZON_SP_API_REFRESH_TOKEN=
YURTICI_API_USER=
YURTICI_API_PASSWORD=
ARAS_API_USER=
ARAS_API_PASSWORD=
META_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
WHATSAPP_TOKEN=
SMS_PROVIDER_KEY=
FX_PROVIDER=tcmb
ANTHROPIC_API_KEY=            # İçerik Stüdyosu ve Koku AI

# --- scripts/setup-env.mjs tarafından eklendi (boş olanlar kurulumda üretilir) ---
DATABASE_URL_TEST=postgresql://atelier:atelier@localhost:5432/atelier_test
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
SESSION_TTL_HOURS=8
DEVICE_SESSION_TTL_HOURS=12
TOTP_ISSUER=Atelier
AUTH_SECRET=
PII_ENC_KEYS=
PII_ENC_ACTIVE_KEY=k1
PII_HASH_KEY=
SEED_ADMIN_EMAIL=admin@atelier.local
SEED_ADMIN_PASSWORD=

# --- scripts/setup-env.mjs tarafından eklendi (boş olanlar kurulumda üretilir) ---
MFA_REQUIRED=false
