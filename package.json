{
  "name": "atelier-erp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "bootstrap": "node scripts/setup-env.mjs",
    "dev": "turbo run dev --filter=@atelier/api --filter=@atelier/web --filter=@atelier/worker",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @atelier/db generate",
    "db:migrate": "pnpm --filter @atelier/db migrate",
    "db:deploy": "pnpm --filter @atelier/db migrate:deploy",
    "db:seed": "pnpm --filter @atelier/db seed",
    "db:studio": "pnpm --filter @atelier/db studio",
    "db:validate": "pnpm --filter @atelier/db validate",
    "test:e2e": "turbo run build --filter=@atelier/api --filter=@atelier/worker && pnpm --filter @atelier/web test:e2e",
    "db:import:showcase": "pnpm --filter @atelier/db import:showcase"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "turbo": "^2.11.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "@next/eslint-plugin-next": "^16.3.0",
    "eslint-plugin-react-hooks": "^7.0.0"
  }
}
